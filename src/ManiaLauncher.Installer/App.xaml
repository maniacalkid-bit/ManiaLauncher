<Application x:Class="ManiaLauncher.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#121212"/>
        <SolidColorBrush x:Key="Surface" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Secondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="Accent" Color="#3A3A3A"/>
    </Application.Resources>
</Application>
