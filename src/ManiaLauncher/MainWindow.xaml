<Window x:Class="ManiaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ManiaLauncher.ViewModels"
        xmlns:cv="clr-namespace:ManiaLauncher.Converters"
        xmlns:svc="clr-namespace:ManiaLauncher.Services"
        xmlns:root="clr-namespace:ManiaLauncher"
        Title="Mania Launcher"
        Height="{Binding Source={x:Static svc:SettingsService.Instance}, Path=WindowHeight, Mode=TwoWay}"
        Width="{Binding Source={x:Static svc:SettingsService.Instance}, Path=WindowWidth, Mode=TwoWay}"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI">

    <Window.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <cv:RatioToPercentConverter x:Key="RatioToPct"/>
        <cv:RatioToHundredConverter x:Key="RatioTo100"/>
        <cv:NullToBoolConverter x:Key="NullToBool"/>
        <cv:StringToVisibilityConverter x:Key="StrToVis"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>   <!-- title bar -->
                <RowDefinition Height="*"/>     <!-- content -->
                <RowDefinition Height="Auto"/>  <!-- footer / play bar -->
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid Grid.Row="0" Background="{StaticResource BrushBgAlt}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="MANIA" FontWeight="Bold" Foreground="{StaticResource BrushTextBright}"
                               FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                               WindowChrome.IsHitTestVisibleInChrome="False"/>
                    <TextBlock Text="LAUNCHER" FontWeight="Light" Foreground="{StaticResource BrushTextDim}"
                               FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource GhostButton}" Width="44" Height="30"
                            Click="BtnMinimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximize" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource GhostButton}" Width="44" Height="30"
                            Click="BtnMaximize_Click" ToolTip="Maximize"/>
                    <Button x:Name="BtnClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="44" Height="30" Click="BtnClose_Click" ToolTip="Close"
                            Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource BrushText}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF6E6E6E"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF545454"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource BrushSidebar}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Nav -->
                        <StackPanel DockPanel.Dock="Top" Margin="10,14,10,0">
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True"
                                         Click="NavHome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Click="NavVersions_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Versions" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Click="NavAccounts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Accounts" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Click="NavSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Click="NavConsole_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Console" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Branding bottom -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Source={x:Static root:AppInfo.Version}, StringFormat=v{0}}"
                                       Foreground="{StaticResource BrushTextDim}" FontSize="11"/>
                            <TextBlock Text="© maniacalkid" Foreground="{StaticResource BrushTextDim}" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock Text="MIT License" Foreground="{StaticResource BrushTextDim}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border/>
                    </DockPanel>
                </Border>

                <!-- PAGES -->
                <Grid Grid.Column="1">
                    <!-- ========== HOME ========== -->
                    <ScrollViewer Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto" Padding="0">
                        <StackPanel Margin="28,24,28,24" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/logo.png" Width="56" Height="56"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mania Launcher" Style="{StaticResource HeaderText}"/>
                                    <TextBlock Text="Minecraft, the way you like it." Style="{StaticResource SubHeaderText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick launch card -->
                            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="VERSION" Style="{StaticResource SubHeaderText}" FontSize="10"/>
                                        <ComboBox Margin="0,6,0,0"
                                                  ItemsSource="{Binding VisibleVersions}"
                                                  SelectedItem="{Binding SelectedVersion, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                                   Foreground="{StaticResource BrushTextBright}"/>
                                                        <TextBlock Text="{Binding TypeLabel}" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource BrushTextDim}" FontSize="11"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="installed" Margin="8,0,0,0" FontSize="11"
                                                                   Foreground="{StaticResource BrushText}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Browse all versions…" Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Margin="-8,4,0,0"
                                                Click="NavVersions_Click" Padding="8,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PLAYING AS" Style="{StaticResource SubHeaderText}" FontSize="10"/>
                                        <ComboBox Margin="0,6,0,0"
                                                  ItemsSource="{Binding Accounts}"
                                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="20" Height="20" CornerRadius="3"
                                                                Background="{StaticResource BrushPanelLight}" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Username, StringFormat={}{0}}"
                                                                       FontSize="10" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource BrushTextBright}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Username}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Manage accounts…" Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Margin="-8,4,0,0"
                                                Click="NavAccounts_Click" Padding="8,4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Info cards -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="AUTOMATIC UPDATES" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextDim}"/>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="The version list is fetched live from Mojang's official manifest. New releases and snapshots appear here automatically — just hit Refresh."/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="OFFLINE ACCOUNTS" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextDim}"/>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="Create local accounts for testing the launcher. They work offline and follow the classic offline-mode UUID scheme."/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushTextDim}" FontSize="11">
                                Mania Launcher is open-source software (MIT) by maniacalkid. Not affiliated with Mojang or Microsoft.
                                Minecraft is a trademark of Mojang Studios.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== VERSIONS ========== -->
                    <Grid Visibility="{Binding IsVersionsPage, Converter={StaticResource BoolToVis}}" Margin="28,24,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Versions" Style="{StaticResource HeaderText}"/>
                            <Button HorizontalAlignment="Right" Command="{Binding RefreshVersionsCommand}"
                                    Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                            <TextBox Width="240" Text="{Binding VersionFilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     ToolTip="Filter by name"/>
                            <CheckBox Content="Snapshots" Margin="18,0,0,0"
                                      IsChecked="{Binding ShowSnapshots}" VerticalAlignment="Center"/>
                            <CheckBox Content="Old versions (alpha/beta)" Margin="18,0,0,0"
                                      IsChecked="{Binding ShowOldVersions}" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource BrushTextDim}"
                                       Text="{Binding VisibleVersions.Count, StringFormat={}{0} shown}"/>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,20">
                            <ListBox Style="{StaticResource VersionList}"
                                     ItemsSource="{Binding VisibleVersions}"
                                     SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     MouseDoubleClick="VersionList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextBright}" FontSize="14"/>
                                                <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="3"
                                                        Background="{StaticResource BrushPanelLight}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                                               Foreground="{StaticResource BrushText}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ReleaseDateLabel}"
                                                       Foreground="{StaticResource BrushTextDim}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{StaticResource BrushText}"
                                                       VerticalAlignment="Center" ToolTip="Installed locally"
                                                       Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ========== ACCOUNTS ========== -->
                    <ScrollViewer Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,24" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="Accounts" Style="{StaticResource HeaderText}"/>
                            <TextBlock Style="{StaticResource SubHeaderText}" Margin="0,6,0,20" TextWrapping="Wrap"
                                       Text="Offline accounts for testing the launcher. They are stored locally and require no internet connection."/>

                            <!-- Add account -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="ADD ACCOUNT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextDim}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="NewAccountBox"
                                                 Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="NewAccountBox_KeyDown"
                                                 ToolTip="2–16 characters: letters, digits, underscore"/>
                                        <Button Grid.Column="1" Content="Add" Margin="10,0,0,0"
                                                Command="{Binding AddAccountCommand}"
                                                Style="{StaticResource PrimaryButton}" MinWidth="80"/>
                                    </Grid>
                                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource BrushTextDim}"
                                               Text="Rules: 2–16 characters, letters (a–z, A–Z), digits and _ only — same as Minecraft."/>
                                </StackPanel>
                            </Border>

                            <!-- Account list -->
                            <TextBlock Text="YOUR ACCOUNTS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextDim}" Margin="4,24,0,8"/>
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushPanel}" CornerRadius="{StaticResource RadiusSm}"
                                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                Margin="0,0,0,8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                                        Background="{StaticResource BrushPanelLight}">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource BrushText}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTextBright}"/>
                                                    <TextBlock Text="{Binding UuidNoDashes, StringFormat=UUID: {0}}"
                                                               FontSize="10" Foreground="{StaticResource BrushTextDim}"
                                                               FontFamily="Consolas" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Select" Style="{StaticResource GhostButton}" Padding="10,5"
                                                            Click="SelectAccount_Click" Tag="{Binding}"/>
                                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="10,5"
                                                            Style="{StaticResource GhostButton}" ToolTip="Remove account"
                                                            Click="RemoveAccount_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Remove selected" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding RemoveAccountCommand}" Padding="12,7"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== SETTINGS ========== -->
                    <ScrollViewer Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,24" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource HeaderText}"/>

                            <!-- Game directory -->
                            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="GAME DIRECTORY" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextDim}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0"
                                                Click="BrowseGameDir_Click" Padding="12,7"/>
                                        <Button Grid.Column="2" Content="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                Margin="8,0,0,0" Padding="10,7" ToolTip="Open folder"
                                                Command="{Binding OpenGameDirCommand}"/>
                                    </Grid>
                                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource BrushTextDim}"
                                               TextWrapping="Wrap"
                                               Text="Where game files (versions, assets, libraries, saves) are stored. Changing it does not move existing files."/>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="MEMORY ALLOCATION" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextDim}"/>
                                        <TextBlock Text="{Binding MaxRamGbLabel}" HorizontalAlignment="Right"
                                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextBright}"/>
                                    </Grid>
                                    <Slider Margin="0,14,0,4" Minimum="512" Maximum="16384"
                                            IsSnapToTickEnabled="True" TickFrequency="512"
                                            Value="{Binding MaxRamMb, Mode=TwoWay}"/>
                                    <Grid>
                                        <TextBlock Text="512 MB" FontSize="10" Foreground="{StaticResource BrushTextDim}"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="16 GB" FontSize="10" Foreground="{StaticResource BrushTextDim}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Java -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="JAVA RUNTIME" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextDim}"/>
                                    <ComboBox Margin="0,10,0,0" ItemsSource="{Binding JavaInstalls}"
                                              SelectedItem="{Binding SelectedJava, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding MajorVersion, StringFormat=Java {0}}"
                                                               FontWeight="SemiBold" MinWidth="56"/>
                                                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource BrushTextDim}"
                                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource BrushTextDim}"
                                               TextWrapping="Wrap"
                                               Text="Leave empty for auto-detect: Java 21 for modern versions, Java 17 for 1.17–1.20.4, Java 8 for older."/>
                                </StackPanel>
                            </Border>

                            <!-- Behavior -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="BEHAVIOR" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextDim}"/>
                                    <CheckBox Content="Close launcher when the game starts" Margin="0,12,0,0"
                                              IsChecked="{Binding CloseLauncherOnStart}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Save settings" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveSettingsCommand}" MinWidth="120"/>
                                <Button Content="Reset to defaults" Margin="10,0,0,0"
                                        Command="{Binding ResetSettingsCommand}" MinWidth="120"/>
                                <Button Content="Open logs folder" Margin="10,0,0,0"
                                        Command="{Binding OpenLogsCommand}" MinWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== CONSOLE ========== -->
                    <Grid Visibility="{Binding IsConsolePage, Converter={StaticResource BoolToVis}}" Margin="28,24,28,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Console" Style="{StaticResource HeaderText}" Margin="0,0,0,14"/>
                        <Border Grid.Row="1" Background="#FF101010" BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
                            <ListBox x:Name="ConsoleList" ItemsSource="{Binding ConsoleLines}"
                                     Background="Transparent" BorderThickness="0" Padding="10"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                     Foreground="{StaticResource BrushText}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     ItemContainerStyle="{x:Null}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas"
                                                   Foreground="{StaticResource BrushText}" FontSize="11.5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= FOOTER / PLAY BAR ================= -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgAlt}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- busy spinner -->
                    <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="20" Height="20" Stroke="{StaticResource BrushBorderLight}" StrokeThickness="2"/>
                        <Ellipse Width="20" Height="20" Stroke="{StaticResource BrushAccent}" StrokeThickness="2"
                                 StrokeDashArray="3 12" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="spin"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="spin"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <!-- status + progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,20,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushText}"
                                   TextTrimming="CharacterEllipsis" FontSize="12"/>
                        <Grid Margin="0,6,0,0" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Value="{Binding Progress, Converter={StaticResource RatioTo100}}" Maximum="100"/>
                            <TextBlock Text="{Binding Progress, Converter={StaticResource RatioToPct}}"
                                       HorizontalAlignment="Right" Margin="0,0,4,0" FontSize="9"
                                       Foreground="{StaticResource BrushTextDim}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- PLAY -->
                    <Button Grid.Column="2" Command="{Binding PlayCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="150" MinHeight="42" FontSize="15" FontWeight="Bold"
                            Content="PLAY"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
