<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         MANIA LAUNCHER — brand palette
         Colors: Black / Dark Gray / Gray / Light Gray / White
         ============================================================ -->

    <!-- Backgrounds -->
    <Color x:Key="ColorBg">#FF0D0D0D</Color>              <!-- black -->
    <Color x:Key="ColorBgAlt">#FF141414</Color>            <!-- near black -->
    <Color x:Key="ColorPanel">#FF1E1E1E</Color>            <!-- dark gray -->
    <Color x:Key="ColorPanelLight">#FF2A2A2A</Color>       <!-- gray -->
    <Color x:Key="ColorBorder">#FF3A3A3A</Color>           <!-- gray border -->
    <Color x:Key="ColorBorderLight">#FF565656</Color>      <!-- light gray border -->

    <!-- Text -->
    <Color x:Key="ColorTextBright">#FFF5F5F5</Color>       <!-- white -->
    <Color x:Key="ColorText">#FFC8C8C8</Color>             <!-- light gray -->
    <Color x:Key="ColorTextDim">#FF8A8A8A</Color>          <!-- gray -->

    <!-- Accent (monochrome) -->
    <Color x:Key="ColorAccent">#FFE8E8E8</Color>           <!-- white accent -->
    <Color x:Key="ColorAccentText">#FF0D0D0D</Color>       <!-- black on accent -->

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}"/>
    <SolidColorBrush x:Key="BrushBgAlt" Color="{StaticResource ColorBgAlt}"/>
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="BrushPanelLight" Color="{StaticResource ColorPanelLight}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}"/>
    <SolidColorBrush x:Key="BrushTextBright" Color="{StaticResource ColorTextBright}"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColorTextDim}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentText" Color="{StaticResource ColorAccentText}"/>
    <SolidColorBrush x:Key="BrushHover" Color="#FF333333"/>
    <SolidColorBrush x:Key="BrushPressed" Color="#FF424242"/>
    <SolidColorBrush x:Key="BrushDisabled" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="BrushDisabledText" Color="#FF5C5C5C"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="BrushSidebar" Color="#FF121212"/>
    <SolidColorBrush x:Key="BrushNavActive" Color="#FF262626"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="BrushOk" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#FF9A9A9A"/>

    <!-- Shared constants -->
    <CornerRadius x:Key="RadiusSm" TopLeft="3" TopRight="3" BottomRight="3" BottomLeft="3"/>
    <CornerRadius x:Key="RadiusMd" TopLeft="5" TopRight="5" BottomRight="5" BottomLeft="5"/>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeHuge">24</sys:Double>

</ResourceDictionary>
