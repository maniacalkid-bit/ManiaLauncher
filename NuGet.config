<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local offline feed: pre-downloaded packages (used on machines with restricted network).
         Safe to keep: NuGet merges sources; use 'dotnet restore - -ignore-failed-sources' offline. -->
    <add key="local-offline" value=".offlinefeed" />
  </packageSources>
</configuration>
